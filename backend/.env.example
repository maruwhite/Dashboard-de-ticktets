# Copiar a backend/.env y completar. El archivo .env nunca se commitea.

# Puerto del backend (opcional, por defecto 3000)
PORT=3000

# Nivel de log: fatal | error | warn | info | debug | trace (opcional, por defecto info)
LOG_LEVEL=info

# Base SQLite local (caché de Jira; se puede borrar y se reconstruye con el próximo sync)
DATABASE_PATH=data/dashboard.db

# Sync con Jira. Sin definir: se activa solo si hay JIRA_BASE_URL; si no, el backend arranca
# en modo demo con la foto anonimizada (ADR-0014). SYNC_ENABLED=false fuerza el modo demo.
SYNC_ENABLED=
SYNC_INTERVAL_MINUTES=5

# Jira: obligatorias con el sync activado
# URL de tu sitio, por ejemplo https://tu-sitio.atlassian.net
JIRA_BASE_URL=
JIRA_EMAIL=
# Token generado en https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=
# Opcional: qué tickets sincronizar (por defecto, los proyectos PRJA a PRJE)
JIRA_JQL=

# Ids de los campos personalizados (los imprime: npm run jira:preparar -w seed)
JIRA_FIELD_CREADA=
JIRA_FIELD_RESUELTA=
JIRA_FIELD_ID_ORIGEN=
JIRA_FIELD_TIPO_PROYECTO=
JIRA_FIELD_RESPONSABLE=
JIRA_FIELD_INFORMADOR=
JIRA_FIELD_RESPONSABLE_PROYECTO=
